# 이 파일을 .env 로 복사한 뒤 키를 넣으세요. .env 는 절대 공유하지 마세요.
OPENAI_API_KEY=sk-...
# 사용할 모델 (기본값: gpt-5.4-mini)
VM_MODEL=gpt-5.4-mini
APP_PASSWORD=원하는-비밀번호

# 외부 트렌드(네이버 검색어 트렌드, 선택) — 네이버 클라우드 플랫폼 콘솔 > NAVER API HUB 에서 발급
# 예전 개발자센터 키를 쓰면 아래 줄의 # 를 지우세요
# NAVER_API=devcenter
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 기존 DB 연결(선택) — 예: sqlite:///C:/data/company.db , postgresql://id:pw@host/db
DATA_DB_URL=

# 대회 제공 AI 게이트웨이를 쓸 때(키는 OPENAI_API_KEY 자리에 넣어도 되고 GATEWAY_KEY로 넣어도 됨)
# OPENAI_BASE_URL=https://gateway-us.pydantic.dev/proxy/lotte-ax-challenge
# VM_MODEL=gpt-6-luna
# VM_API=responses   # 기본값. 게이트웨이가 Chat Completions만 받으면 chat
# 속도(선택): 동시 호출 수(기본 16). 게이트웨이가 429(한도) 오류를 내면 8로 낮추세요.
# VM_WORKERS=16
# 속도(선택): 추론 강도 low/medium/high — 모델이 지원할 때만. 오류가 나면 이 줄을 지우세요.
# VM_REASONING=low
# 매출·절감 표시(선택): 1건 비용(달러), 환율(원/달러), 정성+정량 조사 비용(만원, 기본 2000 = 과제 설명 자료)
# VM_COST_PER_CALL=0.02
# VM_KRW_PER_USD=1400
# VM_SURVEY_COST_MANWON=2000
